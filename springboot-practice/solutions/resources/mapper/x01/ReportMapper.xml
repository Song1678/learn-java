<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learn.web.x01_takeout.mapper.ReportMapper">

    <!--
        x.9 sumAmountByDay：已完成（status = 5）订单，order_time 在 [begin, end)，
        按 DATE(order_time) 分组，返回列 order_date、amount（SUM(amount)），按日期升序。
    -->
    <!-- @answer x.9 写 <select id="sumAmountByDay"> -->
    <select id="sumAmountByDay" resultType="com.learn.web.x01_takeout.domain.vo.DayAmount">
        SELECT DATE(order_time) AS order_date, SUM(amount) AS amount
        FROM orders
        WHERE status = 5
          AND order_time &gt;= #{begin}
          AND order_time &lt; #{end}
        GROUP BY DATE(order_time)
        ORDER BY order_date
    </select>
    <!-- @end -->

    <!--
        x.9 salesTop10：已完成订单的明细，order_time 在 [begin, end)，
        按商品名称分组，返回列 name、number（SUM(od.number)），按 number 降序、name 升序，前 10 个。
    -->
    <!-- @answer x.9 写 <select id="salesTop10"> -->
    <select id="salesTop10" resultType="com.learn.web.x01_takeout.domain.vo.NameNumber">
        SELECT od.name, SUM(od.number) AS number
        FROM order_detail od
        JOIN orders o ON o.id = od.order_id
        WHERE o.status = 5
          AND o.order_time &gt;= #{begin}
          AND o.order_time &lt; #{end}
        GROUP BY od.name
        ORDER BY number DESC, od.name
        LIMIT 10
    </select>
    <!-- @end -->

</mapper>
